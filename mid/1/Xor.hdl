// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Not(in=a, out=a0);
	Not(in=b, out=b0);
	And(a=a, b=b0, out=c1);
	And(a=a0, b=b, out=c2);
	Or(a=c1, b=c2, out=out);
}